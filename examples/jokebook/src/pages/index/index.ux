<template>
  <div class="page">
    <div class="header-area">
      <text class="moon">?</text>
      <text class="header">Joke Book</text>
      <text class="moon">?</text>
    </div>
    <list class="song-list">
      <list-item for="{{jokes}}" class="song-item" type="joke" onclick="openJoke($item.id)">
        <div class="song-row">
          <div class="color-bar" style="background-color: {{ $item.color }};"></div>
          <div class="song-content">
            <text class="song-title">{{ $item.title }}</text>
            <text class="song-dots">{{ $item.dots }}</text>
          </div>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
import jokes from "../../common/jokes"

var colors = [
  "#e57373", "#f06292", "#ba68c8", "#9575cd",
  "#7986cb", "#64b5f6", "#4fc3f7", "#4dd0e1",
  "#4db6ac", "#81c784", "#aed581", "#dce775",
  "#fff176", "#ffd54f", "#ffb74d", "#ff8a65",
  "#a1887f", "#e0e0e0", "#90a4ae", "#80cbc4"
]

export default {
  private: {
    jokes: jokes.map(function (joke, i) {
      var lineCount = joke.lyrics.split("\n").length
      var dots = ""
      for (var d = 0; d < Math.min(lineCount, 12); d++) {
        dots += "."
      }
      return {
        id: joke.id,
        title: joke.title,
        color: colors[i % colors.length],
        dots: dots
      }
    })
  },

  openJoke(id) {
    router.push({
      uri: "/pages/detail",
      params: {
        jokeId: id
      }
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  background-color: #0a0a14;
}

.header-area {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding-top: 10px;
  padding-bottom: 8px;
}

.moon {
  font-size: 12px;
  color: #ffd54f;
  padding-left: 4px;
  padding-right: 4px;
}

.header {
  font-size: 16px;
  color: #e0e0e0;
  font-weight: bold;
  text-align: center;
}

.song-list {
  flex: 1;
  width: 100%;
}

.song-item {
  height: 38px;
  margin-left: 6px;
  margin-right: 6px;
  margin-top: 2px;
  border-radius: 4px;
  background-color: #141425;
}

.song-row {
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.color-bar {
  width: 3px;
  height: 20px;
  border-radius: 2px;
  margin-left: 4px;
  margin-right: 6px;
}

.song-content {
  flex-direction: column;
  flex: 1;
  justify-content: center;
}

.song-title {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.song-dots {
  font-size: 8px;
  color: #555555;
  letter-spacing: 1px;
}
</style>
