.page {
  flex-direction: column;
  background-color: #0a0a14;
}

.header {
  flex-direction: row;
  align-items: center;
  padding-top: 8px;
  padding-bottom: 2px;
  padding-left: 6px;
  padding-right: 6px;
}

.back-btn {
  font-size: 16px;
  color: #e0e0e0;
  width: 16px;
  font-weight: bold;
}

.title-area {
  flex-direction: column;
  flex: 1;
  align-items: center;
  padding-right: 16px;
}

.song-name {
  font-size: 18px;
  color: #ffffff;
  text-align: center;
  font-weight: bold;
}

.title-underline {
  width: 40px;
  height: 2px;
  border-radius: 1px;
  margin-top: 2px;
  margin-bottom: 2px;
}

.lyrics-list {
  flex: 1;
  width: 100%;
}

.lyrics-item-line {
  height: 26px;
  padding-left: 10px;
  padding-right: 10px;
  justify-content: center;
}

.lyrics-item-blank {
  height: 10px;
}

.verse-a {
  font-size: 20px;
  font-weight: bold;
  color: #e0e0e0;
  text-align: right;
}

.verse-b {
  font-size: 20px;
  font-weight: bold;
  color: #b0bec5;
  text-align: right;
}

.blank {
  font-size: 6px;
  color: #0a0a14;
}

.lyrics-line {
  font-size: 20px;
}

.footer {
  justify-content: center;
  align-items: center;
  padding-top: 4px;
  padding-bottom: 8px;
}

.footer-dot {
  font-size: 10px;
  text-align: center;
}
</style>
