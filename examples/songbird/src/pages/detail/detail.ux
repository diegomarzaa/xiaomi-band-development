<template>
  <div class="page">
    <div class="header">
      <text class="back-btn" onclick="goBack">&lt;</text>
      <div class="title-area">
        <text class="song-name">{{ title }}</text>
        <div class="title-underline" style="background-color: {{ color }};"></div>
      </div>
    </div>
    <list class="lyrics-list">
      <list-item for="{{lines}}" class="lyrics-item-{{ $item.type }}" type="{{ $item.type }}">
        <text class="lyrics-line {{ $item.cls }}">{{ $item.text }}</text>
      </list-item>
    </list>
    <div class="footer">
      <text class="footer-dot" style="color: {{ color }};">- - -</text>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import songs from "../../common/songs"

var colors = [
  "#e57373", "#f06292", "#ba68c8", "#9575cd",
  "#7986cb", "#64b5f6", "#4fc3f7", "#4dd0e1",
  "#4db6ac", "#81c784", "#aed581", "#dce775",
  "#fff176", "#ffd54f", "#ffb74d", "#ff8a65",
  "#a1887f", "#e0e0e0", "#90a4ae", "#80cbc4"
]

var FONT_SIZE = 20
var USABLE_WIDTH = 172
var MAX_CHARS = Math.floor(USABLE_WIDTH / (FONT_SIZE * 0.65))

function rev(text) {
  return text.split("").reverse().join("")
}

function wrapText(text, maxChars) {
  if (text.length <= maxChars) return [text]
  var original = rev(text)
  var words = original.split(" ")
  var parts = []
  var current = ""
  for (var w = 0; w < words.length; w++) {
    var word = words[w]
    if (current === "") {
      current = word
    } else if ((current + " " + word).length <= maxChars) {
      current = current + " " + word
    } else {
      parts.push(rev(current))
      current = word
    }
  }
  if (current !== "") parts.push(rev(current))
  return parts
}

export default {
  private: {
    title: "",
    color: "#4fc3f7",
    lines: []
  },

  goBack() {
    router.back()
  },

  onInit() {
    var songId = this.songId
    for (var i = 0; i < songs.length; i++) {
      if (songs[i].id === parseInt(songId)) {
        this.title = songs[i].title
        this.color = colors[i % colors.length]
        var raw = songs[i].lyrics.split("\n")
        var result = []
        var verseNum = 0
        for (var j = 0; j < raw.length; j++) {
          var isBlank = raw[j] === ""
          if (isBlank) {
            verseNum++
            result.push({ text: " ", cls: "blank", type: "blank" })
          } else {
            var cls = verseNum % 2 === 0 ? "verse-a" : "verse-b"
            var wrapped = wrapText(raw[j], MAX_CHARS)
            for (var k = 0; k < wrapped.length; k++) {
              result.push({ text: wrapped[k], cls: cls, type: "line" })
            }
          }
        }
        this.lines = result
        break
      }
    }
  }
}
</script>

